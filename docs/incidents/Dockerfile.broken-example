FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

RUN useradd --create-home appuser
USER appuser

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=3 --start-period=10s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

# deliberately broken: binds to the wrong port, so the health check
# (which always hits 8080) can never succeed - simulates a bad deploy
CMD ["gunicorn", "--bind", "0.0.0.0:9999", "app:app"]
